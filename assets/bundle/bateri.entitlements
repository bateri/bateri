<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The sandbox that runs page modules (a WebAssembly runtime) compiles each module to machine
	     code and runs it; the hardened runtime that notarization requires allows that only with
	     these two. The runtime writes the code into ordinary memory and then makes it executable
	     (it does not map it with MAP_JIT), which is what allow-unsigned-executable-memory is for;
	     allow-jit stays beside it for the compiler's sake. Nothing else is asked for. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
