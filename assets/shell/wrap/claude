# bateri's wrapper of `claude` — what bateri adds to Claude Code's command line, the same on this
# computer and on a server.
#
# It is run by name, `sh wrap/claude claude [ARGUMENT]...`: by the `claude` function of the shell
# (`agents.*`) and by `start`, when something bateri was asked to run is `claude`. The first word
# is the program to run, and the last thing this does is run it (`exec`), so that nothing stays
# between the terminal and Claude Code.
#
# Claude Code is started with `--settings '<hook>'`, so that the end of each turn reaches `bateri
# message` and the tab can show what the agent last said (Settings › Agents). The hook lives and
# ends with that one session: nothing is written to Claude Code's own files. The text of the hook
# is the file `agents/claude.json`, beside the folder this file is in, which the app writes when
# the setting is on and removes when it is off; this reads it at every start, so a change in
# Settings reaches the next `claude` without a new shell. No file, no flag.
#
# The flag is NOT added, and `claude` runs as it was typed, when
#   - the user passed `--settings` themselves (the last one given wins, so theirs would have run,
#     but then the hook would be half there). What follows a `--` is not looked at;
#   - `CLAUDECODE` is set: Claude Code started this, and a `claude -p` it opens must not have its
#     own settings overridden.
# The flag goes before the user's arguments, whatever they are: a subcommand does not care.
#
# Claude Code is also given `--plugin-dir <folder>` when the skill is on (Settings › Agents), so
# that it learns the `bateri` command from the skill in that folder, for that session alone. The
# folder is `agents/claude-plugin`, beside the hook's file, written and removed by the app the
# same way; its skill file is what this looks for, at every start. A Claude Code that does not list
# `--plugin-dir` in its `--help` is not given the flag (it refuses an option it does not know), so
# each start asks it: one call that ends at once, paid only by whoever turned the skill on. The
# flag does not depend on the user's `--settings` (it can be given more than once), and it is not
# added when `CLAUDECODE` is set, for the reason above.

# Every name here starts with `bt_`: a plain `file` or `hook` that the environment carries (it is
# exported to what this runs) would be written over, and Claude Code would get the new value.

bt_program=$1
shift

case $0 in
  */*) bt_shell=${0%/*}/.. ;;
  *) bt_shell=.. ;;
esac
bt_file=$bt_shell/agents/claude.json

bt_hook=
bt_plugin=
if [ -z "${CLAUDECODE-}" ]; then
  if [ -r "$bt_file" ]; then
    bt_hook=$(cat "$bt_file")
    for bt_arg in "$@"; do
      case $bt_arg in
        --) break ;;
        --settings | --settings=*)
          bt_hook=
          break
          ;;
      esac
    done
  fi
  bt_folder=$bt_shell/agents/claude-plugin
  # The option's own line of the help (`  --plugin-dir <path>  Load a plugin…`), not another
  # option's text that names it, nor the line that continues one.
  if [ -r "$bt_folder/skills/bateri/SKILL.md" ] \
    && "$bt_program" --help 2>/dev/null < /dev/null | grep -q -E '^ {1,6}(-[A-Za-z], )?--plugin-dir([ =<[,]|$)'; then
    bt_plugin=$bt_folder
  fi
fi

if [ -n "$bt_hook" ]; then
  set -- --settings "$bt_hook" "$@"
fi
if [ -n "$bt_plugin" ]; then
  set -- --plugin-dir "$bt_plugin" "$@"
fi
exec "$bt_program" "$@"
