#!/bin/sh
# bateri on a machine — what an agent (Claude Code, Codex) asks of the bateri
# that shows this machine's panes. POSIX sh; written to
# `~/.local/share/bateri/shell/bin/bateri` by the bootstrap (`boot.sh`) on a server and by
# the application on this Mac, and put on `PATH` by the integration of zsh, bash and fish.
#
#   bateri split [PANE | --tab TAB] [--left|--right|--above|--below] [--ratio PERCENT]
#          [--label TEXT] [--cwd DIR] [--keep-open] [--wait] [--focus] [--json] [-S SERVER]
#          [-- PROGRAM...]
#   bateri tab   [PANE] [--group GROUP | --window WINDOW] [--new-group NAME] [--label TEXT]
#          [--cwd DIR] [--keep-open] [--wait] [--focus] [--json] [-S SERVER] [-- PROGRAM...]
#   bateri window [--cwd DIR] [--keep-open] [--wait] [--focus] [--json] [-S SERVER] [-- PROGRAM...]
#   bateri close pane [PANE] [--force]      bateri close tab|group|window [ID]
#   bateri ls [--json]       bateri notify TEXT...
#   bateri send [PANE] [TEXT | -]           bateri send-key [PANE] KEY...
#   bateri capture [PANE] [OPTIONS]         bateri wait PANE [--for TIME]
#   bateri focus pane|tab|group|window [ID]   bateri zoom [PANE]   bateri swap PANE PANE
#   bateri rename pane|tab|group ID LABEL   (an empty label takes it away)
#   bateri move pane [PANE] --beside PANE --left|--right|--above|--below [--json]
#   bateri move pane [PANE] --tab TAB [--left|--right|--above|--below] [--json]
#   bateri move pane [PANE] --new-tab [NAME] [--group GROUP | --window WINDOW] [--new-group NAME] [--json]
#   bateri move tab [TAB] --group GROUP | --window WINDOW | --new-group NAME [--window WINDOW] [--json]
#   bateri resize [PANE] --left|--right|--above|--below [--by N]
#
# THE RULES OF THE WORDS. The word after a verb is what it acts on, an id; with none named it is
# the one this runs in (`wait`, `swap` and `rename` name theirs). A verb that takes several kinds
# says the kind first. Where something goes is a flag. `--label` names what the verb itself opens;
# `--new-tab NAME` and `--new-group NAME` name what they make along the way; `rename` names what is
# there. Standard output has the id of what was made, and `--json` says where it stands.
#
# WHO DOES WHAT. The terminal is the machine's: `kablo new` starts it here, it
# gets a number (`p9`, `next.sh`) and `send`, `capture` and `wait` are kablo's
# own, with no Mac anywhere. The Mac only decides where a pane that shows the
# terminal goes: `split`, `tab` and `window` tell it so over kablo's app channel
# (`kablo app`, one `bateri 2` message, `agent::message` in bateri) and it
# answers how the pane landed. It runs nothing and types nothing into any
# shell. When no Mac is connected the same message waits in
# `~/.local/share/bateri/placing/pN` and the Mac reads it when it connects.
# `focus`, `zoom`, `swap`, `move`, `resize`, `rename tab|group` and `close tab|group|window` are the
# Mac's alone (they need its windows): with none connected they end with 69. A word of a kind and
# an id of another (`focus group t3`), a field that contradicts another (`split p9 --tab t3`) and
# `close` with no kind are mistakes that end with 64 before the Mac is asked, and say what to
# write. The Mac refuses (77) what would take the keyboard from where the person is typing and
# what the level for this machine does not allow. A pane's label is kablo's own (`kablo label`):
# `split --label` and `rename pane` write it, and no Mac is asked.
# The pane goes beside the one named (`split p4`) or, with none named,
# beside the one this runs in, whatever that is called (`kablo here`): a
# terminal the Mac opened before the numbers existed is `b-` and 32 digits, and one
# numbered before the unit was the pane is `t` and a number: it runs on, and is no pane to name.
# Run in no terminal (cron) with none named there is nothing to go beside: the
# terminal starts and waits in the Mac's list of terminals running in the
# background, and the command says so on one line.
#
# THE ANSWERS. Standard output has the pane's number (`--json`: an object of it,
# where it stands as the Mac says it — its tab, the tab's group, the window,
# each `null` where there is none — and how it landed); a pane that did not
# land as asked says so on one line of standard error. Exit codes: 0, 1, 64 (a mistake in the command), 69
# (what needs a Mac, with none connected), 77 (refused), 128+n, and for `wait`
# the program's own, 124 when the time ran out, 255 for kablo's trouble.
#
# WHO OPENED WHAT. `~/.local/share/bateri/terminals/pN` says which terminal
# opened pN (`kablo here` — what the system says of the process, never a
# variable) and whether it stays open; `ls` shows it, and nothing decides by
# it. WHAT MAY BE DONE is the level the Mac has for this machine (`off`,
# `own`, `screen`, `full`: the `[remote] hosts` entry of settings.toml for a server, `[commands]
# level` for this Mac itself — the Mac reads them, not this script), and nobody is asked.
# `close pane` goes to the Mac, which closes the pane that shows the terminal as the
# user closing it would (a pane that stays open for `--keep-open` goes too);
# named nothing it is the caller's own terminal, under whatever name it has.
# With no Mac to ask, any terminal of this machine is ended with `kablo end`:
# it is this machine's own at every level that has the command. The state is
# under `$HOME`, not `XDG_DATA_HOME`: the Mac and a cron job do not have a
# login shell's environment (the counter's reason, `next.sh`).
#
# THIS MAC. The same file runs on the Mac itself, and nothing in it says which. There is no
# bootstrap file here (`boot.sh`, a server pane's) — and that one fact is what differs: a
# `split` with no program has no bootstrap to start, so nothing is started; the number is taken
# and the Mac is asked for an ordinary pane of this Mac under that name (`fresh`), whose shell is
# the one the Mac starts for any pane. A `--keep-open` pane is kept open by the terminal itself:
# the program runs, and the user's login shell follows it in the same terminal (a server's is
# held by the Mac's pipe to it).
#
# ANOTHER MACHINE. `-S SERVER` starts the terminal on a server instead of here: the name `ssh` is
# given (`prod`, an alias of ~/.ssh/config), through the same gate as `ssh prod` in a bateri pane
# (the settings, `ssh -G`, a server bateri keeps terminals on) and with no list of its own. Only a
# machine whose level is `full` may (the Mac says 77 to the others), and the server's own
# `commands` must not be `off`. The Mac is asked first for the `ssh` words that ride the connection
# it keeps (it asks the person for a password in a sheet when the connection must be made); this
# runs the `bateri` of the server over that, by its full path in a login shell, in the server's home
# unless `--cwd` names a directory there, and the terminal is the server's `pN`; then the Mac is
# asked for the pane (`place`, with `server`) beside this machine's. Nothing is installed on the
# server: one that was never opened from bateri is told to be. The terminal is written `p9@prod`,
# as `ls` writes the panes of other machines (this Mac is `@local`): `send`, `send-key`,
# `capture` and `wait` carry the command to the server over the same connection, and `focus`,
# `close` and the layout verbs hand the address to the Mac (from level `screen`; they need no
# connection). The exit code 255 is ssh's for a connection that failed and kablo's for its own
# trouble: the line printed says which.
#
# FROM A SERVER. A server has no ssh to the other machine; the Mac does. Run on a server given
# `full`, the same commands go to the Mac, which answers the `ssh` request with the word `relay`
# and then runs the command itself: a `relay` message names the machine (`prod`, or `@local` for
# this Mac) and carries the words, which the Mac turns into the `bateri` of that machine run from
# its full path in a login shell, as above, and says how it ended (`ok relayed`: the status, the
# lines of stderr, stdout as it was). So the Mac RUNS A PROGRAM here — the one place it does, for
# `full` alone (`own` and `screen` end with 77, before a relay is read); a taken-over server given
# `full` can do on the person's other machines what the person can. Only `split` (the terminal
# the pane shows), `send`, `send-key`, `capture`, `wait` and `close` are relayed. `-S @local` and
# `p9@local` are this Mac for a program on a server (on the Mac itself they are the plain pane).
# A `split` with no program on this Mac needs a pane to go beside, which a relayed command is
# not in: name a program.
#
# The quoted word below is filled in when the bootstrap writes this file
# (`ssh_wrap`): kablo's place relative to home.

unset CDPATH
# The state this writes is the user's alone, but the terminals it starts are the user's to use:
# they get the umask the caller had, not this one (`bt_open`).
bt_umask=$(umask)
umask 077

bt_kablo_rel='__BATERI_KABLO__'
nl='
'

bt_say() {
  printf 'bateri: %s\n' "$*" >&2
}

bt_die() {
  bt_code=$1
  shift
  bt_say "$*"
  exit "$bt_code"
}

bt_usage() {
  printf '%s\n' \
    'usage: bateri split [PANE | --tab TAB] [--left|--right|--above|--below] [--ratio PERCENT]' \
    '                    [--label TEXT] [--cwd DIR] [--keep-open] [--wait] [--focus] [--json]' \
    '                    [-S SERVER] [-- PROGRAM [ARG]...]' \
    '       bateri tab [PANE] [--group GROUP | --window WINDOW] [--new-group NAME] [--label TEXT]' \
    '                  [--cwd DIR] [--keep-open] [--wait] [--focus] [--json] [-S SERVER]' \
    '                  [-- PROGRAM [ARG]...]' \
    '       bateri window [--cwd DIR] [--keep-open] [--wait] [--focus] [--json] [-S SERVER]' \
    '                     [-- PROGRAM [ARG]...]' \
    '       bateri close pane [PANE] [--force]' \
    '       bateri close tab|group|window [ID]' \
    '       bateri ls [--json]' \
    '       bateri notify TEXT...' \
    '       bateri send [PANE] [TEXT | -]' \
    '       bateri send-key [PANE] KEY...' \
    '       bateri capture [PANE] [--history ROWS] [--unwrap] [--trim] [--vt]' \
    '       bateri wait PANE [--for TIME]' \
    '       bateri focus pane|tab|group|window [ID]' \
    '       bateri zoom [PANE]' \
    '       bateri swap PANE PANE' \
    '       bateri rename pane|tab|group ID LABEL' \
    '       bateri move pane [PANE] --beside PANE --left|--right|--above|--below [--json]' \
    '       bateri move pane [PANE] --tab TAB [--left|--right|--above|--below] [--json]' \
    '       bateri move pane [PANE] --new-tab [NAME] [--group GROUP | --window WINDOW] [--new-group NAME]' \
    '                               [--json]' \
    '       bateri move tab [TAB] --group GROUP | --window WINDOW | --new-group NAME [--window WINDOW] [--json]' \
    '       bateri resize [PANE] --left|--right|--above|--below [--by N]' \
    'An id is a letter and a number: p9 a pane, t3 a tab, g1 a group, w1 a window; bateri ls shows them.' \
    'A pane is p and its number (p7); with none named it is the one this runs in. One of another' \
    'machine is written with the machine after an @ (p9@prod), as bateri ls writes it; -S starts a' \
    'terminal on a server, or on this Mac from a server (-S @local) (full level only).' \
    'Without a program, split, tab and window open a shell. bateri ls lists what is open.'
}

case ${HOME-} in
  /*) ;;
  *) bt_die 1 'HOME is not set' ;;
esac
bt_state=$HOME/.local/share/bateri

# kablo: the place the bootstrap filled in, else one on PATH.
bt_kablo=
case $bt_kablo_rel in
  __BATERI_*) ;;
  *)
    if [ -x "$HOME/$bt_kablo_rel" ]; then
      bt_kablo=$HOME/$bt_kablo_rel
    fi
    ;;
esac
if [ -z "$bt_kablo" ]; then
  bt_kablo=$(command -v kablo 2>/dev/null) || bt_kablo=
fi
[ -n "$bt_kablo" ] || bt_die 1 'kablo is not installed on this machine; open a terminal in bateri again'

# The directory this file's bootstrap wrote its siblings to (`shell/`): the
# one `bin/` sits in. `boot.sh` and `next.sh` are beside it.
bt_self=$0
case $bt_self in
  */*) ;;
  *) bt_self=$(command -v "$bt_self" 2>/dev/null) || bt_self=/ ;;
esac
bt_bin=${bt_self%/*}
case $bt_bin in
  /*) ;;
  *) bt_bin=$(cd "$bt_bin" 2>/dev/null && pwd) || bt_bin= ;;
esac
case $bt_bin in
  */shell/bin) bt_shelldir=${bt_bin%/bin} ;;
  *) bt_shelldir=$HOME/.local/share/bateri/shell ;;
esac

# The command for what this starts: a terminal gets the `PATH` of whoever ran this file, and the
# window's relay runs it by its path from a login shell that never had the command. A program
# there calls `bateri` all the same.
case $bt_bin in
  */shell/bin)
    case ":${PATH-}:" in
      *":$bt_bin:"*) ;;
      *) PATH=$bt_bin${PATH:+:$PATH} ;;
    esac
    ;;
esac

# ─── small pieces ────────────────────────────────────────────────────────

# `bt_split TEXT`: the first line in `bt_l1`, the rest in `bt_rest`.
bt_split() {
  case $1 in
    *"$nl"*)
      bt_l1=${1%%"$nl"*}
      bt_rest=${1#*"$nl"}
      ;;
    *)
      bt_l1=$1
      bt_rest=
      ;;
  esac
}

# Whether $1 names an agent's pane: p and a number written plainly (the
# Mac reads exactly this, `agent::Terminal::parse`).
bt_is_terminal() {
  case $1 in
    p0) return 0 ;;
    p[1-9]*) ;;
    *) return 1 ;;
  esac
  case ${1#p} in
    *[!0-9]*) return 1 ;;
  esac
  [ "${#1}" -le 19 ]
}

# Whether $2 is the name of a window (`w`), a group (`g`) or a tab (`t`), $1 being that letter:
# the letter and a number written plainly (`t3`), as the Mac gives it (`ids`).
bt_is_id() {
  case $2 in
    "$1"[1-9]*) ;;
    *) return 1 ;;
  esac
  case ${2#"$1"} in
    *[!0-9]*) return 1 ;;
  esac
  [ "${#2}" -le 19 ]
}

# Whether $1 is a name kablo gives a terminal: 1 to 64 of `A-Za-z0-9._-` (the Mac
# reads exactly this where it takes a terminal that is no agent's number, `agent::Anchor`).
bt_is_name() {
  case $1 in
    '' | *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  [ "${#1}" -le 64 ]
}

# The terminal this runs in, `bt_me` (empty outside every terminal), under whatever name
# it has: the ones before the numbers (`b-` and 32 digits) and the ones a person made with
# `kablo new` are as much a terminal as p4.
bt_here() {
  bt_me=
  if bt_h=$("$bt_kablo" here 2>/dev/null) && bt_is_name "$bt_h"; then
    bt_me=$bt_h
  fi
}

# Text from outside, safe to print on a terminal: no control character but
# the line break and the tab.
bt_clean() {
  tr -d '\000-\010\013-\037\177'
}

# `bt_check_label WHAT TEXT`: a label the Mac and kablo take: 1 to 64 bytes of one line of
# plain text, not only spaces (`agent::message`, `LABEL_MAX`; kablo's own limit is the same).
bt_check_label() {
  bt_cl_size=$(printf '%s' "$2" | wc -c | tr -d ' ')
  if [ "$bt_cl_size" -lt 1 ] || [ "$bt_cl_size" -gt 64 ]; then
    bt_die 64 "$1 is 1 to 64 bytes"
  fi
  bt_cl_plain=$(printf '%s' "$2" | tr -d '\000-\037\177' | wc -c | tr -d ' ')
  [ "$bt_cl_plain" = "$bt_cl_size" ] || bt_die 64 "$1 is one line of plain text"
  [ -n "$(printf '%s' "$2" | tr -d ' ')" ] || bt_die 64 "$1 is not only spaces"
  # `tab --new-group g1` means the group g1 or is a slip for it: a name is never taken for an id.
  ! bt_reads_as_id "$2" || bt_die 64 "$1 '$2' reads as an id: give it a name that does not"
}

# Whether $1 reads as the id of a pane, a tab, a group or a window.
bt_reads_as_id() {
  bt_is_kind p "$1" || bt_is_kind t "$1" || bt_is_kind g "$1" || bt_is_kind w "$1"
}

# `bt_wrong_kind VERB KINDS WORDS WORD`: VERB, which says the kind first, got WORD. An id of one of
# KINDS (`pane:p tab:t`) gets told what to write; WORDS says what the verb takes.
bt_wrong_kind() {
  for bt_wk in $2; do
    if bt_is_kind "${bt_wk#*:}" "$4"; then
      bt_die 64 "$1 takes the kind before the id. Did you mean: bateri $1 ${bt_wk%:*} $4"
    fi
  done
  bt_die 64 "$1 takes $3, not '$(printf '%s' "$4" | bt_clean)'"
}

bt_not_a_terminal() {
  bt_say "'$(printf '%s' "$1" | bt_clean)' is not a pane: name one as p and its number (p7)${2-}; 'bateri ls' lists them"
  "$bt_kablo" list 2>/dev/null | head -n 30 >&2
  exit 64
}

bt_need_terminal() {
  bt_is_terminal "$1" || bt_not_a_terminal "$1"
}

# Whether $1 names a machine as `bateri ls` writes it after the @ of an address: the host as `ssh`
# is given it without its user, or `local` for this Mac (the Mac reads the same alphabet,
# `agent::is_machine`).
bt_is_machine() {
  case $1 in
    '' | [!A-Za-z0-9]* | *[!A-Za-z0-9._:-]*) return 1 ;;
  esac
  [ "${#1}" -le 253 ]
}

# Whether $1 names a server as `-S` takes it: as `ssh` is given it (`prod`, an alias or a host of
# ~/.ssh/config), starting with a letter or a digit so that it can never be read as an option; or
# `@local`, this Mac. No `user@`: a pane of another machine is written with the host alone
# (`p9@prod`), so two accounts of one host could not be told apart; the user goes in ~/.ssh/config.
bt_is_server() {
  [ "$1" != @local ] || return 0
  case $1 in
    '' | [!A-Za-z0-9]* | *[!A-Za-z0-9._:-]*) return 1 ;;
  esac
  [ "${#1}" -le 253 ]
}

# Whether this runs on the Mac itself: there is no bootstrap file here (`boot.sh`, a server's).
bt_on_mac() {
  [ ! -r "$bt_shelldir/boot.sh" ]
}

# `bt_address WORD`: a pane written as p9, or p9@prod for one of another machine, in `bt_a_id` and
# `bt_a_machine` (empty for a plain one); fails for what is neither.
bt_address() {
  bt_a_id=$1
  bt_a_machine=
  case $1 in
    *@*)
      bt_a_id=${1%%@*}
      bt_a_machine=${1#*@}
      bt_is_machine "$bt_a_machine" || return 1
      ;;
  esac
  bt_is_terminal "$bt_a_id"
}

# `bt_quote WORD`: WORD in single quotes in `bt_q`, as every shell a remote command line may meet
# reads them (a quote in WORD closes them, is written `\'` and opens them again).
bt_sq="'"
bt_quote() {
  bt_qr=$1
  bt_q=$bt_sq
  while :; do
    case $bt_qr in
      *"$bt_sq"*)
        bt_q="$bt_q${bt_qr%%"$bt_sq"*}$bt_sq\\$bt_sq$bt_sq"
        bt_qr=${bt_qr#*"$bt_sq"}
        ;;
      *)
        bt_q="$bt_q$bt_qr$bt_sq"
        return 0
        ;;
    esac
  done
}

# `bt_ask MESSAGE`: one conversation with the Mac. `bt_status` is kablo's
# status (69: no Mac connected) and `bt_reply` what it said, byte for byte (the
# trailing `x` keeps the substitution from eating the last line breaks).
bt_ask() {
  bt_out=$(printf '%s' "$1" | "$bt_kablo" app 2>/dev/null; printf 'x%s' "$?")
  bt_status=${bt_out##*x}
  bt_reply=${bt_out%x*}
}

# The reply read as `bt_kind` (`ok`, `ok placed`, `ok text`, `ok relayed` or `error KIND`),
# `bt_text` (the words of an error) and `bt_body` (what follows); `bt_kind`
# is empty for a reply that is not `bateri 2`'s.
bt_read_reply() {
  bt_kind=
  bt_text=
  bt_body=
  bt_split "$bt_reply"
  [ "$bt_l1" = 'bateri 2' ] || return 0
  bt_split "$bt_rest"
  bt_body=$bt_rest
  case $bt_l1 in
    'ok' | 'ok placed' | 'ok text' | 'ok relayed') bt_kind=$bt_l1 ;;
    'error '*)
      bt_words=${bt_l1#error }
      case $bt_words in
        *' '*)
          bt_kind="error ${bt_words%% *}"
          bt_text=${bt_words#* }
          ;;
        *) bt_kind="error $bt_words" ;;
      esac
      ;;
  esac
}

# The exit code of an error reply.
bt_error_code() {
  case $bt_kind in
    'error usage') return 64 ;;
    'error refused') return 77 ;;
    *) return 1 ;;
  esac
}

bt_fail_reply() {
  bt_error_code
  bt_code=$?
  bt_die "$bt_code" "$(printf '%s' "$bt_text" | bt_clean)"
}

# ─── another machine ─────────────────────────────────────────────────────

# `bt_reach SERVER`: asks the Mac how to reach SERVER over ssh. The Mac judges the level (`full`),
# the name (the gate of `ssh SERVER` in a bateri pane) and the server's own `commands`, makes the
# connection when it must (a password is asked in a sheet) and answers with the words of the
# command, one `arg` line each, kept in `bt_ssh_body`; to a program on a server, which has no ssh
# to run, with the one word `relay` (`bt_relay`).
bt_reach() {
  bt_ask "bateri 2${nl}ssh${nl}server $1${nl}"
  [ "$bt_status" != 69 ] || bt_die 69 "no Mac is connected: it is the Mac that reaches $1"
  [ "$bt_status" = 0 ] || bt_die 1 'the Mac did not answer'
  bt_read_reply
  case $bt_kind in
    'ok text') bt_ssh_body=$bt_body ;;
    'error '*) bt_fail_reply ;;
    *) bt_die 1 'the Mac answered with something this does not read' ;;
  esac
  bt_ssh_server=$1
}

# `bt_hexwords WORD...`: the words as the other machine's `bateri --hex` takes them, in `bt_hex`
# (each `x` and the hex of its bytes, a space before it): nothing the caller wrote is ever read by a
# shell on the way, whichever shell that is.
bt_hexwords() {
  bt_hex=
  for bt_w in "$@"; do
    bt_hex="$bt_hex x$(printf '%s' "$bt_w" | od -An -v -tx1 | tr -d ' \n')"
  done
}

# `bt_remote WORD...`: the `bateri WORD...` of `bt_ssh_server`, over ssh, as the Mac said (`bt_reach`);
# when the Mac said `relay` (this runs on a server, which has no ssh to it) it runs it (`bt_relay`).
# The line the server's shells read is fixed text and the words in hex (`bateri --hex`), so that
# fish, zsh, bash and dash all read it the same: a `sh` hands over to the login shell, which runs a
# `sh` that looks for the script where the files of that machine are and says so when it is
# nowhere (nothing is installed here: a server bateri never opened is told to be). The status is the
# command's, or 255 when ssh could not connect.
bt_remote() {
  case $bt_ssh_body in
    relay | relay"$nl"*)
      bt_relay "$@"
      return
      ;;
  esac
  bt_hexwords "$@"
  bt_search='for d in "${XDG_DATA_HOME:-$HOME/.local/share}" "$HOME/.local/share"; do [ -x "$d/bateri/shell/bin/bateri" ] && exec env BATERI_QUIET_ORPHAN=1 "$d/bateri/shell/bin/bateri" --hex "$@"; done; echo "bateri: bateri is not set up on '"$bt_ssh_server"': open a terminal on it in bateri first" >&2; exit 127'
  bt_quote "$bt_search"
  bt_login="exec sh -c $bt_q sh$bt_hex"
  bt_quote "$bt_login"
  bt_login_word=$bt_q
  bt_quote 'exec "${SHELL:-/bin/sh}" -lc "$1"'
  bt_line="exec sh -c $bt_q sh $bt_login_word"
  set -- ssh
  bt_lines=$bt_ssh_body
  while [ -n "$bt_lines" ]; do
    bt_split "$bt_lines"
    bt_lines=$bt_rest
    case $bt_l1 in
      'arg '*) set -- "$@" "${bt_l1#arg }" ;;
    esac
  done
  "$@" "$bt_line"
}

# `bt_relay WORD...`: `bateri WORD...` on `bt_ssh_server`, run by the Mac. The words go as hex (`x` and
# the bytes in hex: a line break in a `send` cannot ride a line), and what comes back is the
# command's status, a few lines of its stderr and its stdout as it was, which are printed as they
# would have been. `send ID -` reads its text here, since standard input does not cross.
bt_relay() {
  bt_verb=$1
  bt_rn=$#
  while [ "$bt_rn" -gt 0 ]; do
    bt_w=$1
    shift
    bt_rn=$((bt_rn - 1))
    if [ "$bt_verb" = send ] && [ "$bt_w" = - ]; then
      bt_w=$(
        cat
        printf x
      )
      bt_w=${bt_w%x}
    fi
    set -- "$@" "$bt_w"
  done
  bt_hexwords "$@"
  bt_ask "bateri 2${nl}relay${nl}server $bt_ssh_server${nl}words$bt_hex${nl}"
  [ "$bt_status" != 69 ] || bt_die 69 "no Mac is connected: it is the Mac that runs this on $bt_ssh_server"
  [ "$bt_status" = 0 ] || bt_die 1 'the Mac did not answer'
  bt_read_reply
  case $bt_kind in
    'ok relayed') ;;
    'error '*) bt_fail_reply ;;
    *) bt_die 1 'the Mac answered with something this does not read' ;;
  esac
  bt_split "$bt_body"
  bt_rcode=${bt_l1#status }
  bt_split "$bt_rest"
  bt_rlines=${bt_l1#stderr }
  case $bt_rcode in '' | *[!0-9]*) bt_die 1 'the Mac answered with something this does not read' ;; esac
  case $bt_rlines in '' | *[!0-9]*) bt_die 1 'the Mac answered with something this does not read' ;; esac
  bt_rout=$bt_rest
  while [ "$bt_rlines" -gt 0 ]; do
    bt_split "$bt_rout"
    printf '%s\n' "$bt_l1" >&2
    bt_rout=$bt_rest
    bt_rlines=$((bt_rlines - 1))
  done
  printf '%s' "$bt_rout"
  return "$bt_rcode"
}

# `bt_carry MACHINE WORD...`: `bateri WORD...` for a pane of another machine, run where it is. This
# Mac's own panes are this Mac's (`@local` here is the plain pane).
bt_carry() {
  bt_via=$1
  shift
  [ "$bt_via" != local ] || bt_via=@local
  bt_reach "$bt_via"
  bt_remote "$@"
  bt_code=$?
  case $bt_code in
    255) bt_say "could not reach $bt_via over ssh, or kablo had trouble there" ;;
  esac
  exit "$bt_code"
}

# ─── split, tab ──────────────────────────────────────────────────────────

# `bt_open MODE ARGS...` (`split`, `tab` or `window`): starts a terminal here and
# tells the Mac where its pane goes.
bt_open() {
  bt_mode=$1
  shift
  bt_anchor=
  bt_side=
  bt_ratio=
  bt_cwd=
  bt_keep=
  bt_wait=
  bt_focus=
  bt_json=
  bt_home_tab=
  bt_home_group=
  bt_home_window=
  bt_home_newgroup=
  bt_label=
  bt_server=
  bt_server_here=
  while [ $# -gt 0 ]; do
    case $1 in
      --)
        shift
        break
        ;;
      -S)
        [ -z "$bt_server" ] || bt_die 64 'name one server'
        [ $# -ge 2 ] || bt_die 64 '-S takes a server'
        shift
        bt_server=$1
        case $bt_server in
          -*) bt_die 64 "a server's name does not start with a dash: '$(printf '%s' "$bt_server" | bt_clean)'" ;;
        esac
        bt_is_server "$bt_server" || bt_die 64 "-S takes a server as ssh does ('prod', an alias or a host of ~/.ssh/config, with no user@) or @local, not '$(printf '%s' "$bt_server" | bt_clean)'"
        if [ "$bt_server" = @local ] && bt_on_mac; then
          # This Mac is where this runs: the terminal "on this Mac" is the plain one. A second -S is
          # still a mistake, so the name stays until the loop is done.
          bt_server_here=yes
        fi
        ;;
      --left | --right | --above | --below)
        [ "$bt_mode" = split ] || bt_die 64 "$bt_mode takes no side"
        [ -z "$bt_side" ] || bt_die 64 'name one side'
        bt_side=${1#--}
        ;;
      --ratio | --ratio=*)
        [ "$bt_mode" = split ] || bt_die 64 "$bt_mode takes no ratio"
        case $1 in
          --ratio=*) bt_ratio=${1#--ratio=} ;;
          *)
            [ $# -ge 2 ] || bt_die 64 '--ratio takes a percent'
            shift
            bt_ratio=$1
            ;;
        esac
        case $bt_ratio in
          [1-9] | [1-9][0-9]) ;;
          *) bt_die 64 '--ratio is a percent from 1 to 99' ;;
        esac
        ;;
      --cwd | --cwd=*)
        case $1 in
          --cwd=*) bt_cwd=${1#--cwd=} ;;
          *)
            [ $# -ge 2 ] || bt_die 64 '--cwd takes a directory'
            shift
            bt_cwd=$1
            ;;
        esac
        [ -n "$bt_cwd" ] || bt_die 64 '--cwd takes a directory'
        ;;
      --tab | --tab=*)
        [ "$bt_mode" = split ] || bt_die 64 "$bt_mode takes no --tab: a pane goes into a tab (split --tab t3)"
        [ -z "$bt_home_tab" ] || bt_die 64 'name one tab'
        case $1 in
          --tab=*) bt_home_tab=${1#--tab=} ;;
          *)
            [ $# -ge 2 ] || bt_die 64 '--tab takes a tab'
            shift
            bt_home_tab=$1
            ;;
        esac
        bt_check_id split tab "$bt_home_tab"
        ;;
      --group | --group=*)
        [ "$bt_mode" = tab ] || bt_die 64 "$bt_mode takes no --group: a tab goes into a group (tab --group g1)"
        [ -z "$bt_home_group" ] || bt_die 64 'name one group'
        case $1 in
          --group=*) bt_home_group=${1#--group=} ;;
          *)
            [ $# -ge 2 ] || bt_die 64 '--group takes a group'
            shift
            bt_home_group=$1
            ;;
        esac
        bt_check_id tab group "$bt_home_group"
        ;;
      --window | --window=*)
        [ "$bt_mode" = tab ] || bt_die 64 "$bt_mode takes no --window: a tab goes into a window (tab --window w1)"
        [ -z "$bt_home_window" ] || bt_die 64 'name one window'
        case $1 in
          --window=*) bt_home_window=${1#--window=} ;;
          *)
            [ $# -ge 2 ] || bt_die 64 '--window takes a window'
            shift
            bt_home_window=$1
            ;;
        esac
        bt_check_id tab window "$bt_home_window"
        ;;
      --new-group | --new-group=*)
        [ "$bt_mode" = tab ] || bt_die 64 "$bt_mode takes no --new-group: a tab goes into a group made for it (tab --new-group api)"
        [ -z "$bt_home_newgroup" ] || bt_die 64 'name one new group'
        case $1 in
          --new-group=*) bt_home_newgroup=${1#--new-group=} ;;
          *)
            [ $# -ge 2 ] || bt_die 64 '--new-group takes the name of the group'
            shift
            bt_home_newgroup=$1
            ;;
        esac
        bt_check_label '--new-group' "$bt_home_newgroup"
        ;;
      --label | --label=*)
        [ "$bt_mode" != window ] || bt_die 64 'window takes no --label: a window has no label; rename tab names the tab in it'
        [ -z "$bt_label" ] || bt_die 64 'name one label'
        case $1 in
          --label=*) bt_label=${1#--label=} ;;
          *)
            [ $# -ge 2 ] || bt_die 64 '--label takes a text'
            shift
            bt_label=$1
            ;;
        esac
        bt_check_label '--label' "$bt_label"
        ;;
      --keep-open) bt_keep=yes ;;
      --focus) bt_focus=yes ;;
      --wait) bt_wait=yes ;;
      --json) bt_json=yes ;;
      -*) bt_die 64 "$bt_mode takes no option '$(printf '%s' "$1" | bt_clean)'" ;;
      *)
        [ "$bt_mode" != window ] || bt_die 64 'window goes beside no pane; a program goes after --'
        [ -z "$bt_anchor" ] || bt_die 64 'the program goes after --'
        bt_anchor=$1
        ;;
    esac
    shift
  done
  [ -z "$bt_server_here" ] || bt_server=
  case $bt_mode in
    tab | window) bt_side=tab ;;
  esac
  [ "$bt_mode" != window ] || bt_home_window=new
  # What does not go together is a mistake here, before anything is started (the Mac reads the
  # same rules, `agent::message::Home::check`).
  if [ -n "$bt_home_tab" ] && [ -n "$bt_anchor" ]; then
    bt_die 64 'split goes beside a pane or into a tab (--tab), not both'
  fi
  if [ -n "$bt_home_group" ] && { [ -n "$bt_home_window" ] || [ -n "$bt_home_newgroup" ]; }; then
    bt_die 64 '--group is a group that is in its window already: it goes with no --window and no --new-group'
  fi
  if [ -n "$bt_anchor" ] && { [ -n "$bt_home_group" ] || [ -n "$bt_home_window" ]; }; then
    bt_die 64 'tab goes beside a pane or into a group or a window, not both'
  fi
  # A pane's label is kablo's own; a tab's is the Mac's.
  bt_pane_label=
  bt_tab_label=
  if [ "$bt_mode" = split ]; then
    bt_pane_label=$bt_label
  else
    bt_tab_label=$bt_label
  fi

  bt_here
  bt_orphan=
  if [ -n "$bt_anchor" ]; then
    # What the agent writes is a number: a name that is no number is no target. Most often it is
    # the program, written where a pane goes.
    bt_is_terminal "$bt_anchor" || bt_not_a_terminal "$bt_anchor" '; a program goes after --'
  elif [ -n "$bt_me" ]; then
    # The caller's own terminal, whatever it is called (kablo says it, from the system).
    bt_anchor=$bt_me
  else
    # Run in no terminal (cron) and no anchor named: nothing to put a pane beside. The
    # terminal starts all the same and waits in the Mac's list of terminals running in
    # the background, which is where a terminal no pane shows goes.
    bt_orphan=yes
  fi

  # Where it starts: the caller's directory; on a server (`-S`) the server's, its home unless
  # `--cwd` names one there (the server says if it is none).
  if [ -n "$bt_server" ]; then
    [ "$(printf '%s' "$bt_cwd" | bt_clean | tr -d '\n')" = "$bt_cwd" ] || bt_die 64 'the directory has a control character in its name'
  else
    case $bt_cwd in
      '~') bt_cwd=$HOME ;;
      '~/'*) bt_cwd=$HOME/${bt_cwd#'~/'} ;;
      '')
        bt_cwd=$PWD
        [ -d "$bt_cwd" ] || bt_cwd=$HOME
        ;;
    esac
    [ -d "$bt_cwd" ] || bt_die 1 "'$(printf '%s' "$bt_cwd" | bt_clean)' is not a directory"
  fi

  # The program, or bateri's shell: the bootstrap's file, run from the file
  # (`boot.sh`), with no parent block, nonce or tab. Where there is none (this Mac) nothing is
  # started: the Mac opens the pane's own shell under the number (`fresh`).
  bt_fresh=
  if [ -n "$bt_server" ]; then
    # The server starts it with its own `bateri`: its bootstrap's shell, or the program.
    :
  elif [ $# -eq 0 ]; then
    if [ -r "$bt_shelldir/boot.sh" ]; then
      bt_version=${LC_TERMINAL_VERSION-}
      case $bt_version in
        *[!0-9A-Za-z.+-]*) bt_version= ;;
      esac
      set -- sh "$bt_shelldir/boot.sh" '' '' "$bt_version" -
    else
      [ -z "$bt_wait" ] || bt_die 64 '--wait needs a program here: name one after --'
      [ -z "$bt_orphan" ] || bt_die 1 'a pane with no program goes beside a pane: run this in a bateri terminal, or name one'
      [ "$(printf '%s' "$bt_cwd" | bt_clean | tr -d '\n')" = "$bt_cwd" ] || bt_die 64 'the directory has a control character in its name'
      bt_fresh=$bt_cwd
    fi
  elif [ -n "$bt_keep" ] && [ ! -r "$bt_shelldir/boot.sh" ]; then
    # No Mac pipe holds this terminal after its program: the terminal itself carries on with
    # the user's login shell.
    set -- sh -c '"$@"; exec "${SHELL:-/bin/sh}" -l' sh "$@"
  fi

  # The number, and the terminal. A hand-made terminal can hold the number
  # (`kablo new --id t5`): the next is tried.
  bt_tid=
  bt_tries=0
  while [ -z "$bt_server" ]; do
    bt_n=$(sh "$bt_shelldir/next.sh" 2>/dev/null) || bt_n=
    case $bt_n in
      '' | *[!0-9]* | 0*) bt_die 1 "cannot number a pane: $bt_state is not writable, or bateri's files are not in $bt_shelldir" ;;
    esac
    bt_id=p$bt_n
    # No terminal to start: the Mac makes it, under this number.
    [ -z "$bt_fresh" ] || break
    # In a subshell: the new terminal inherits this process, so it gets the caller's umask and
    # none of the caller's own terminal identity (the tab it stands in is not the new pane's).
    if bt_err=$(
      umask "$bt_umask" 2>/dev/null
      unset LC_BATERI_TAB_URL BATERI_TAB_URL TERM_SESSION_ID BATERI_QUIET_ORPHAN
      # The dock's tier (the Mac's `"blocks"`) goes on to the new terminal: its shell reads it.
      if [ "${BATERI_DOCK-}" = off ]; then
        "$bt_kablo" new --id "$bt_id" ${bt_pane_label:+--label "$bt_pane_label"} --cwd "$bt_cwd" --env "PATH=$PATH" --env BATERI_DOCK=off -- "$@" 2>&1 >/dev/null
      else
        "$bt_kablo" new --id "$bt_id" ${bt_pane_label:+--label "$bt_pane_label"} --cwd "$bt_cwd" --env "PATH=$PATH" -- "$@" 2>&1 >/dev/null
      fi
    ); then
      break
    fi
    bt_tries=$((bt_tries + 1))
    case $bt_err in
      *'exists already'*) [ "$bt_tries" -lt 5 ] && continue ;;
    esac
    bt_die 1 "kablo could not start $bt_id: $(printf '%s' "$bt_err" | bt_clean)"
  done
  if [ -n "$bt_server" ]; then
    bt_start_on "$@"
  else
    bt_record "$bt_id"
  fi

  bt_landed=
  bt_mac_waits=
  bt_next=
  bt_squeezed=no
  bt_hidden=no
  bt_tab=
  bt_group=
  bt_window=
  if [ -n "$bt_orphan" ]; then
    bt_landed=waiting
  else
    bt_place
  fi
  bt_open_report

  if [ -n "$bt_wait" ]; then
    # Not `kablo new --wait`: kablo keeps what a Mac shows for ten minutes after the
    # program ends, and `new --wait` would come back that much later; `wait`
    # does not.
    if [ -n "$bt_server" ]; then
      bt_remote wait "$bt_tid" </dev/null
      exit $?
    fi
    exec "$bt_kablo" wait "$bt_id"
  fi
  exit 0
}

# `bt_start_on [PROGRAM...]`: the terminal is started on `bt_server` by its own `bateri split`, run
# in no terminal there, which numbers it and says the number (`bt_tid`); `bt_id` is the address
# the Mac and `ls` write it by (`p9@prod`).
bt_start_on() {
  bt_reach "$bt_server"
  set -- split ${bt_cwd:+--cwd "$bt_cwd"} ${bt_pane_label:+--label "$bt_pane_label"} ${bt_keep:+--keep-open} -- "$@"
  bt_out=$(bt_remote "$@" </dev/null)
  bt_code=$?
  if [ "$bt_code" != 0 ]; then
    [ "$bt_code" != 255 ] || bt_say "could not reach $bt_server over ssh"
    [ "$bt_code" != 127 ] || bt_code=1
    exit "$bt_code"
  fi
  # A login shell may print lines of its own before: the number is the last line.
  bt_tid=${bt_out##*"$nl"}
  bt_is_terminal "$bt_tid" || bt_die 1 "$bt_server did not say which terminal it started"
  bt_id=$bt_tid@${bt_server##*@}
}

# Who opened $1, and whether it stays: `~/.local/share/bateri/terminals/pN`,
# plain `key value` lines.
bt_record() {
  mkdir -p "$bt_state/terminals" 2>/dev/null || return 0
  bt_file=$bt_state/terminals/$1
  {
    printf 'opener %s\n' "${bt_me:--}"
    printf 'keep-open %s\n' "${bt_keep:-no}"
  } > "$bt_file.tmp.$$" 2>/dev/null && mv -f "$bt_file.tmp.$$" "$bt_file" 2>/dev/null
  rm -f "$bt_file.tmp.$$"
}

# The `place` message (`agent::message`, version 2: its text is frozen) and the
# conversation. The anchor is always written out: a message that waits is read
# when no conversation names its sender.
bt_place() {
  bt_msg="bateri 2${nl}place${nl}terminal ${bt_tid:-$bt_id}${nl}anchor $bt_anchor${nl}"
  [ -z "$bt_side" ] || bt_msg="${bt_msg}side $bt_side${nl}"
  [ -z "$bt_ratio" ] || bt_msg="${bt_msg}ratio $bt_ratio${nl}"
  [ -z "$bt_keep" ] || bt_msg="${bt_msg}keep-open yes${nl}"
  [ -z "$bt_focus" ] || bt_msg="${bt_msg}focus yes${nl}"
  [ -z "$bt_fresh" ] || bt_msg="${bt_msg}fresh $bt_fresh${nl}"
  [ -z "$bt_server" ] || bt_msg="${bt_msg}server $bt_server${nl}"
  [ -z "$bt_home_tab" ] || bt_msg="${bt_msg}tab $bt_home_tab${nl}"
  [ -z "$bt_home_group" ] || bt_msg="${bt_msg}group $bt_home_group${nl}"
  [ -z "$bt_home_newgroup" ] || bt_msg="${bt_msg}new-group $bt_home_newgroup${nl}"
  [ -z "$bt_home_window" ] || bt_msg="${bt_msg}window $bt_home_window${nl}"
  [ -z "$bt_tab_label" ] || bt_msg="${bt_msg}label $bt_tab_label${nl}"
  bt_ask "$bt_msg"
  if [ "$bt_status" = 0 ]; then
    bt_read_reply
    case $bt_kind in
      'ok placed')
        bt_placed
        return 0
        ;;
      'error '*)
        # The Mac refused: nothing is left running for a request that failed.
        if [ -n "$bt_server" ]; then
          # In a subshell: a Mac that relays it answers in the variables of this reply, and
          # fails in its own way; neither is what the person is told.
          (bt_remote close pane "$bt_tid" --force) </dev/null >/dev/null 2>&1
        else
          "$bt_kablo" end "$bt_id" --force >/dev/null 2>&1
          rm -f "$bt_state/terminals/$bt_id"
        fi
        bt_fail_reply
        ;;
    esac
    bt_say 'the Mac answered with something this does not read; its pane will be placed when it next connects'
  elif [ "$bt_status" != 69 ]; then
    bt_say 'the Mac did not answer; its pane will be placed when it next connects'
  fi
  bt_wait_note
}

# What the Mac said of a pane that was placed.
bt_placed() {
  bt_landed=as_asked
  bt_mac_waits=
  bt_kept=
  bt_lines=$bt_body
  while [ -n "$bt_lines" ]; do
    bt_split "$bt_lines"
    bt_lines=$bt_rest
    bt_val=${bt_l1#* }
    case $bt_l1 in
      'landed '*)
        case $bt_val in
          as_asked | beside_group | new_tab) bt_landed=$bt_val ;;
          waiting)
            # The Mac has it: it waits for its anchor to be on screen.
            bt_landed=waiting
            bt_mac_waits=yes
            ;;
        esac
        ;;
      'next-to '*) bt_is_name "$bt_val" && bt_next=$bt_val ;;
      'squeezed yes') bt_squeezed=yes ;;
      'hidden yes') bt_hidden=yes ;;
      'keyboard stayed') bt_kept=yes ;;
      'tab '*) ! bt_is_id t "$bt_val" || bt_tab=$bt_val ;;
      'group '*) ! bt_is_id g "$bt_val" || bt_group=$bt_val ;;
      'window '*) ! bt_is_id w "$bt_val" || bt_window=$bt_val ;;
    esac
  done
}

# No Mac to place it: the message waits on the server.
bt_wait_note() {
  bt_landed=waiting
  if [ -n "$bt_server" ]; then
    # The terminal runs on the server and is in its list; the Mac has no pane for it yet.
    bt_mac_waits=yes
    return 0
  fi
  if mkdir -p "$bt_state/placing" 2>/dev/null &&
    printf '%s' "$bt_msg" > "$bt_state/placing/$bt_id.tmp.$$" 2>/dev/null &&
    mv -f "$bt_state/placing/$bt_id.tmp.$$" "$bt_state/placing/$bt_id" 2>/dev/null; then
    :
  else
    rm -f "$bt_state/placing/$bt_id.tmp.$$"
    bt_say "$bt_id could not be put in the line for a Mac ($bt_state is not writable); it runs, and the Mac lists it"
  fi
}

# The answer: the number, or the object (every key always there, `null` where the Mac has not
# said: the pane waits for a window, or its tab is in no group); and one line when the pane is
# not where it was asked to be.
bt_open_report() {
  if [ -n "$bt_json" ]; then
    bt_json_next=null
    [ -z "$bt_next" ] || bt_json_next=\"$bt_next\"
    bt_json_tab=null
    [ -z "$bt_tab" ] || bt_json_tab=\"$bt_tab\"
    bt_json_group=null
    [ -z "$bt_group" ] || bt_json_group=\"$bt_group\"
    bt_json_window=null
    [ -z "$bt_window" ] || bt_json_window=\"$bt_window\"
    printf '{"pane":"%s","tab":%s,"group":%s,"window":%s,"landed":"%s","next_to":%s,"squeezed":%s,"hidden":%s}\n' \
      "$bt_id" "$bt_json_tab" "$bt_json_group" "$bt_json_window" "$bt_landed" "$bt_json_next" \
      "$([ "$bt_squeezed" = yes ] && echo true || echo false)" \
      "$([ "$bt_hidden" = yes ] && echo true || echo false)"
  else
    printf '%s\n' "$bt_id"
  fi
  # The anchor as a line says it: its number, or "this terminal" for the caller's own when
  # that has none.
  bt_said=$bt_anchor
  if [ -n "$bt_anchor" ] && ! bt_is_terminal "$bt_anchor" && [ "$bt_anchor" = "$bt_me" ]; then
    bt_said='this terminal'
  fi
  case $bt_landed in
    waiting)
      if [ -n "$bt_orphan" ]; then
        # A server's script that `-S` started (`bt_remote`) is told not to say it: the caller
        # says it once, for the address it gives.
        [ -n "${BATERI_QUIET_ORPHAN-}" ] || bt_say "$bt_id waits in the Mac's list of terminals running in the background: this ran in no terminal, so it has no pane to go beside"
      elif [ -n "$bt_mac_waits" ] && [ -z "$bt_next" ]; then
        # The Mac kept nothing to place it by: it could not make the pane just now.
        bt_say "$bt_id waits in the Mac's list of terminals running in the background: the Mac could not make its pane now"
      elif [ -n "$bt_mac_waits" ]; then
        bt_say "$bt_id waits in the Mac's list of terminals running in the background, until $bt_said is on screen"
      else
        bt_say "$bt_id will take its place when a Mac connects"
      fi
      ;;
    new_tab) bt_say "$bt_id is in a tab of its own: there was no room beside $bt_said" ;;
    beside_group) bt_say "$bt_id is beside the group of $bt_said: $bt_said is too small to split" ;;
  esac
  if [ "$bt_hidden" = yes ]; then
    bt_say "$bt_id is behind a pane that fills its tab"
  fi
  if [ "$bt_kept" = yes ]; then
    bt_say "$bt_id did not take the keyboard: the cursor is in another pane of that window; bateri notify asks the user to look"
  fi
}

# ─── close, ls, notify ───────────────────────────────────────────────────

# `close pane|tab|group|window [ID]`: the kind is written, never guessed (`close p9` and a bare
# `close` are mistakes that say what to write).
bt_close() {
  [ $# -ge 1 ] || bt_die 64 'close names what closes: pane, tab, group or window. Did you mean: bateri close pane'
  bt_ckind=$1
  shift
  case $bt_ckind in
    pane | tab | group | window) ;;
    *) bt_wrong_kind close 'pane:p tab:t group:g window:w' 'pane, tab, group or window' "$bt_ckind" ;;
  esac
  [ "$bt_ckind" != pane ] || bt_close_pane "$@"

  # A tab, a group or a window belongs to the Mac's windows: with none connected it ends with 69.
  [ $# -le 1 ] || bt_die 64 "close $bt_ckind names one id"
  bt_cid=${1-}
  case $bt_cid in
    -*) bt_die 64 "close $bt_ckind takes no option '$(printf '%s' "$bt_cid" | bt_clean)'" ;;
  esac
  if [ -n "$bt_cid" ]; then
    bt_check_id close "$bt_ckind" "$bt_cid"
  else
    bt_need_here "name the $bt_ckind to close (close $bt_ckind ID)"
  fi
  bt_msg="bateri 2${nl}close${nl}subject $bt_ckind${nl}"
  [ -z "$bt_cid" ] || bt_msg="${bt_msg}id $bt_cid${nl}"
  bt_do "$bt_msg"
}

bt_close_pane() {
  bt_force=
  bt_target=
  for bt_a in "$@"; do
    case $bt_a in
      --force) bt_force=--force ;;
      -*) bt_die 64 "close takes no option '$(printf '%s' "$bt_a" | bt_clean)'" ;;
      *)
        [ -z "$bt_target" ] || bt_die 64 'close pane names one pane'
        bt_target=$bt_a
        ;;
    esac
  done
  bt_here
  if [ -z "$bt_target" ]; then
    [ -n "$bt_me" ] || bt_die 64 'this is run in no terminal; name the pane to close (close pane p4)'
    # The caller's own terminal under whatever name it has: a target has to be a number
    # only where it is written, and nobody wrote this one.
    bt_target=$bt_me
  else
    bt_check_id close pane "$bt_target"
  fi

  # The Mac closes it (the pane and the terminal as one); it refuses (77) with the level it
  # has for this machine and the setting that changes it.
  bt_ask "bateri 2${nl}close${nl}terminal $bt_target${nl}"
  if [ "$bt_status" = 0 ]; then
    bt_read_reply
    case $bt_kind in
      ok)
        # A kill that does not wait out the grace is kablo's to do; a pane of another machine is
        # not this machine's terminal to kill, nor to forget.
        case $bt_target in
          *@*) ;;
          *)
            if [ -n "$bt_force" ]; then
              "$bt_kablo" end "$bt_target" --force >/dev/null 2>&1
            fi
            rm -f "$bt_state/terminals/$bt_target" "$bt_state/placing/$bt_target"
            ;;
        esac
        exit 0
        ;;
      # It could not tell just now (the server's list did not come in time): the terminal is
      # this machine's own all the same.
      'error failed') ;;
      'error '*) bt_fail_reply ;;
    esac
  fi

  # No Mac to ask, or it could not tell: the terminal is this machine's own and kablo ends it. A
  # pane of another machine is the Mac's to close, or nobody's.
  case $bt_target in
    *@*) bt_die 69 "no Mac is connected to close $bt_target: a pane of another machine is closed through it" ;;
  esac
  if [ -n "$bt_force" ]; then
    "$bt_kablo" end "$bt_target" --force
  else
    "$bt_kablo" end "$bt_target"
  fi
  bt_code=$?
  if [ "$bt_code" = 0 ]; then
    rm -f "$bt_state/terminals/$bt_target" "$bt_state/placing/$bt_target"
  fi
  exit "$bt_code"
}

bt_ls() {
  bt_format=
  for bt_a in "$@"; do
    case $bt_a in
      --json) bt_format="format json${nl}" ;;
      *) bt_die 64 "ls takes no '$(printf '%s' "$bt_a" | bt_clean)'" ;;
    esac
  done
  bt_ask "bateri 2${nl}ls${nl}$bt_format"
  bt_why='no Mac is connected'
  if [ "$bt_status" = 0 ]; then
    bt_read_reply
    case $bt_kind in
      'ok text')
        printf '%s' "$bt_body" | bt_clean
        exit 0
        ;;
      # It could not tell just now (the server's list did not come in time): what the server
      # has is better than nothing, as it is with no Mac.
      'error failed') bt_why='the Mac could not tell what is on screen' ;;
      'error '*) bt_fail_reply ;;
    esac
  fi
  # No Mac: what the server has, and what waits to be placed.
  bt_say "$bt_why: these are the panes on this server, and none says where it is"
  if [ -n "$bt_format" ]; then
    exec "$bt_kablo" list --json
  fi
  "$bt_kablo" list
  bt_code=$?
  bt_header=
  for bt_f in "$bt_state"/placing/p*; do
    [ -r "$bt_f" ] || continue
    bt_id=${bt_f##*/}
    bt_is_terminal "$bt_id" || continue
    bt_side=
    bt_anchor=
    bt_ratio=
    while IFS=' ' read -r bt_k bt_v; do
      case $bt_k in
        anchor) bt_anchor=$bt_v ;;
        side) bt_side=$bt_v ;;
        ratio) bt_ratio=$bt_v ;;
      esac
    done < "$bt_f"
    if [ -z "$bt_header" ]; then
      printf '\nWaiting for a Mac to place:\n'
      bt_header=1
    fi
    bt_share=
    [ -z "$bt_ratio" ] || bt_share=" ($bt_ratio%)"
    printf '  %s  %s %s%s\n' "$bt_id" "${bt_side:-beside}" "$bt_anchor" "$bt_share"
  done
  exit "$bt_code"
}

bt_notify() {
  [ $# -gt 0 ] || bt_die 64 'notify takes the words to show'
  bt_words=$(printf '%s' "$*" | tr '\n\t\r' '   ' | bt_clean)
  [ -n "$bt_words" ] || bt_die 64 'notify takes the words to show'
  [ "$(printf '%s' "$bt_words" | wc -c | tr -d ' ')" -le 1000 ] || bt_die 64 'notify shows at most 1000 bytes'
  bt_ask "bateri 2${nl}notify${nl}text $bt_words${nl}"
  if [ "$bt_status" = 0 ]; then
    bt_read_reply
    case $bt_kind in
      ok) exit 0 ;;
      'error '*) bt_fail_reply ;;
    esac
    bt_die 1 'the Mac answered with something this does not read'
  fi
  bt_die 69 'no Mac is connected to show it'
}

# ─── focus, zoom, swap, move, resize ─────────────────────────────────────

# `bt_check_id VERB KIND ID`: whether ID is the id of a KIND (`pane`, `tab`, `group`, `window`).
# One of another kind is a mistake that says so and, for the verbs that take every kind, what to
# write (`t3 is a tab, not a group. Did you mean: bateri focus tab t3`).
bt_check_id() {
  bt_ck_verb=$1
  bt_ck_kind=$2
  bt_ck_id=$3
  case $bt_ck_kind in
    pane) bt_ck_letter=p ;;
    tab) bt_ck_letter=t ;;
    group) bt_ck_letter=g ;;
    window) bt_ck_letter=w ;;
  esac
  if bt_is_kind "$bt_ck_letter" "$bt_ck_id"; then
    return 0
  fi
  for bt_ck_other in pane:p tab:t group:g window:w; do
    bt_ck_word=${bt_ck_other%:*}
    bt_ck_l=${bt_ck_other#*:}
    [ "$bt_ck_l" != "$bt_ck_letter" ] || continue
    if bt_is_kind "$bt_ck_l" "$bt_ck_id"; then
      case $bt_ck_verb in
        focus | close | rename | move) bt_die 64 "$bt_ck_id is a $bt_ck_word, not a $bt_ck_kind. Did you mean: bateri $bt_ck_verb $bt_ck_word $bt_ck_id" ;;
        *) bt_die 64 "$bt_ck_id is a $bt_ck_word, not a $bt_ck_kind: $bt_ck_verb takes a $bt_ck_kind" ;;
      esac
    fi
  done
  [ "$bt_ck_kind" != pane ] || bt_not_a_terminal "$bt_ck_id"
  bt_die 64 "'$(printf '%s' "$bt_ck_id" | bt_clean)' is not a $bt_ck_kind: name one as $bt_ck_letter and its number (${bt_ck_letter}1); 'bateri ls' lists them"
}

# Whether $2 is an id of the kind whose letter is $1.
bt_is_kind() {
  case $1 in
    p) bt_address "$2" ;;
    *) bt_is_id "$1" "$2" ;;
  esac
}

# `bt_do MESSAGE`: a request only the Mac can carry out, since it is about its windows.
bt_do() {
  bt_ask "$1"
  if [ "$bt_status" = 0 ]; then
    bt_read_reply
    case $bt_kind in
      ok) exit 0 ;;
      'error '*) bt_fail_reply ;;
    esac
    bt_die 1 'the Mac answered with something this does not read'
  fi
  bt_die 69 'no Mac is connected to do it'
}

# The caller's own terminal is the default pane; run in no terminal there is none.
bt_need_here() {
  bt_here
  [ -n "$bt_me" ] || bt_die 64 "this is run in no terminal; $1"
}

bt_focus_verb() {
  [ $# -ge 1 ] || bt_die 64 'focus names what gets the keyboard: pane, tab, group or window (focus tab t3)'
  bt_fsubject=$1
  shift
  case $bt_fsubject in
    pane | tab | group | window) ;;
    *) bt_wrong_kind focus 'pane:p tab:t group:g window:w' 'pane, tab, group or window' "$bt_fsubject" ;;
  esac
  [ $# -le 1 ] || bt_die 64 "focus $bt_fsubject names one id"
  bt_fid=${1-}
  case $bt_fid in
    -*) bt_die 64 "focus takes no option '$(printf '%s' "$bt_fid" | bt_clean)'" ;;
  esac
  if [ -n "$bt_fid" ]; then
    bt_check_id focus "$bt_fsubject" "$bt_fid"
  else
    bt_need_here "name the $bt_fsubject to focus (focus $bt_fsubject ID)"
    # A pane that is the caller's own is named by whatever name it has.
    if [ "$bt_fsubject" = pane ]; then
      bt_fid=$bt_me
    fi
  fi
  bt_msg="bateri 2${nl}focus${nl}subject $bt_fsubject${nl}"
  [ -z "$bt_fid" ] || bt_msg="${bt_msg}id $bt_fid${nl}"
  bt_do "$bt_msg"
}

bt_zoom_verb() {
  [ $# -le 1 ] || bt_die 64 'zoom names one pane'
  bt_msg="bateri 2${nl}zoom${nl}"
  if [ $# -eq 1 ]; then
    bt_check_id zoom pane "$1"
    bt_msg="${bt_msg}terminal $1${nl}"
  else
    bt_need_here 'name the pane to zoom (zoom p4)'
  fi
  bt_do "$bt_msg"
}

bt_swap_verb() {
  [ $# -eq 2 ] || bt_die 64 'swap names two panes (swap p4 p5)'
  bt_check_id swap pane "$1"
  bt_check_id swap pane "$2"
  [ "$1" != "$2" ] || bt_die 64 'swap names two different panes'
  bt_do "bateri 2${nl}swap${nl}terminal $1${nl}other $2${nl}"
}

# The side flag of `move` and `resize`: `bt_side` is its word.
bt_take_side() {
  [ -z "$bt_side" ] || bt_die 64 'name one side'
  bt_side=${1#--}
}

# `rename pane|tab|group ID LABEL`: an empty label takes it away. A pane's label is kablo's own
# (the Mac is not asked); a tab's and a group's are the Mac's.
bt_rename_verb() {
  [ $# -ge 1 ] || bt_die 64 'rename names what gets a label: pane, tab or group (rename tab t3 web)'
  bt_rkind=$1
  shift
  case $bt_rkind in
    pane | tab | group) ;;
    window) bt_die 64 'a window has no label' ;;
    *) bt_wrong_kind rename 'pane:p tab:t group:g' 'pane, tab or group' "$bt_rkind" ;;
  esac
  [ $# -ge 1 ] || bt_die 64 "rename names the $bt_rkind to label (rename $bt_rkind ID LABEL)"
  bt_rid=$1
  shift
  bt_check_id rename "$bt_rkind" "$bt_rid"
  case $bt_rid in
    *@*) bt_die 64 "a pane's label is kablo's own on its machine: rename the pane there ($bt_rid is on another machine)" ;;
  esac
  [ $# -ge 1 ] || bt_die 64 "rename needs a label: rename $bt_rkind $bt_rid LABEL (an empty one takes it away)"
  bt_rlabel=$*
  [ -z "$bt_rlabel" ] || bt_check_label label "$bt_rlabel"
  case $bt_rkind in
    pane) exec "$bt_kablo" label "$bt_rid" "$bt_rlabel" ;;
    group) [ -n "$bt_rlabel" ] || bt_die 64 'a group always has a label: say which' ;;
  esac
  bt_msg="bateri 2${nl}rename${nl}subject $bt_rkind${nl}id $bt_rid${nl}"
  [ -z "$bt_rlabel" ] || bt_msg="${bt_msg}label $bt_rlabel${nl}"
  bt_do "$bt_msg"
}

bt_move_verb() {
  [ $# -ge 1 ] || bt_die 64 'move names what moves: move pane p9 --beside p3 --right, or move tab t3 --group g1'
  case $1 in
    pane)
      shift
      bt_move_pane "$@"
      ;;
    tab)
      shift
      bt_move_tab "$@"
      ;;
    *) bt_wrong_kind move 'pane:p tab:t' 'a pane or a tab' "$1" ;;
  esac
}

# `bt_move_place OPTION NEXT`: an option that says where a tab goes, shared by `move tab` and
# `move pane --new-tab`, the words of `bateri tab`. `bt_mshift` says whether NEXT was its value;
# any other option fails.
bt_move_place() {
  bt_mshift=0
  case $1 in
    --json)
      bt_json=yes
      return 0
      ;;
    --group | --window | --new-group)
      bt_mkey=${1#--}
      if [ $# -lt 2 ]; then
        case $bt_mkey in
          group) bt_die 64 '--group takes a group' ;;
          window) bt_die 64 '--window takes a window' ;;
          new-group) bt_die 64 '--new-group takes the name of the group' ;;
        esac
      fi
      bt_mval=$2
      bt_mshift=1
      ;;
    --group=* | --window=* | --new-group=*)
      bt_mkey=${1%%=*}
      bt_mkey=${bt_mkey#--}
      bt_mval=${1#*=}
      ;;
    *) return 1 ;;
  esac
  case $bt_mkey in
    group)
      [ -z "$bt_mgroup" ] || bt_die 64 'name one group'
      bt_mgroup=$bt_mval
      ;;
    window)
      [ -z "$bt_mwindow" ] || bt_die 64 'name one window'
      bt_mwindow=$bt_mval
      ;;
    new-group)
      [ -z "$bt_mnew" ] || bt_die 64 'name one new group'
      bt_check_label '--new-group' "$bt_mval"
      bt_mnew=$bt_mval
      ;;
  esac
}

# What the place says, checked as `bateri tab` checks it and added to `bt_msg`.
bt_move_place_lines() {
  if [ -n "$bt_mgroup" ] && [ -n "$bt_mwindow" ]; then
    bt_die 64 'a tab goes into a group or into a window, not both'
  fi
  if [ -n "$bt_mgroup" ] && [ -n "$bt_mnew" ]; then
    bt_die 64 'a tab goes into a group or into a new group, not both'
  fi
  if [ -n "$bt_mgroup" ]; then
    bt_check_id move group "$bt_mgroup"
    bt_msg="${bt_msg}group $bt_mgroup${nl}"
  fi
  [ -z "$bt_mnew" ] || bt_msg="${bt_msg}new-group $bt_mnew${nl}"
  if [ -n "$bt_mwindow" ]; then
    bt_check_id move window "$bt_mwindow"
    bt_msg="${bt_msg}window $bt_mwindow${nl}"
  fi
  [ -z "$bt_mlabel" ] || bt_msg="${bt_msg}label $bt_mlabel${nl}"
}

# `bt_moved MESSAGE`: a move, which the Mac answers with where the pane's or the tab's tab stands:
# `bt_tab`, `bt_group` and `bt_window`.
bt_moved() {
  bt_tab=
  bt_group=
  bt_window=
  bt_ask "$1"
  if [ "$bt_status" = 0 ]; then
    bt_read_reply
    case $bt_kind in
      'ok placed')
        bt_placed
        return 0
        ;;
      'error '*) bt_fail_reply ;;
    esac
    bt_die 1 'the Mac answered with something this does not read'
  fi
  bt_die 69 'no Mac is connected to do it'
}

# `bt_json_id ID`: the id as a JSON value, `null` where there is none.
bt_json_id() {
  if [ -n "$1" ]; then
    printf '"%s"' "$1"
  else
    printf 'null'
  fi
}

# `move tab [TAB] --group GROUP | --window WINDOW | --new-group NAME [--window WINDOW]`: into the
# group, into the window out of any group, or into a group made for it, which the answer names.
# The tab keeps its id.
bt_move_tab() {
  bt_mtab=
  bt_mgroup=
  bt_mwindow=
  bt_mnew=
  bt_mlabel=
  bt_json=
  while [ $# -gt 0 ]; do
    if bt_move_place "$@"; then
      shift "$bt_mshift"
    else
      case $1 in
        --label | --label=*) bt_die 64 'move tab takes no --label: rename tab names it' ;;
        -*) bt_die 64 "move tab takes no option '$(printf '%s' "$1" | bt_clean)'" ;;
        *)
          [ -z "$bt_mtab" ] || bt_die 64 'move names one tab'
          bt_mtab=$1
          ;;
      esac
    fi
    shift
  done
  if [ -n "$bt_mtab" ]; then
    bt_check_id move tab "$bt_mtab"
  else
    bt_need_here 'name the tab to move (move tab t3 --group g1)'
  fi
  [ -n "$bt_mgroup$bt_mwindow$bt_mnew" ] || bt_die 64 'move tab needs a place: --group GROUP, --window WINDOW or --new-group NAME'
  bt_msg="bateri 2${nl}move${nl}subject tab${nl}"
  [ -z "$bt_mtab" ] || bt_msg="${bt_msg}id $bt_mtab${nl}"
  bt_move_place_lines
  bt_moved "$bt_msg"
  if [ -n "$bt_json" ]; then
    printf '{"tab":%s,"group":%s,"window":%s}\n' "$(bt_json_id "$bt_tab")" "$(bt_json_id "$bt_group")" "$(bt_json_id "$bt_window")"
  elif [ -n "$bt_mnew" ]; then
    printf '%s\n' "$bt_group"
  fi
  exit 0
}

# The word that names the new tab of `move pane --new-tab`. An id here is the pane written in the
# wrong place, and taken for a name it would move another pane than the one meant.
bt_move_tab_name() {
  ! bt_reads_as_id "$1" || bt_die 64 "'$1' reads as an id, not a name: the pane goes before --new-tab (move pane p9 --new-tab web)"
  bt_check_label '--new-tab' "$1"
  bt_mlabel=$1
}

# `move pane [PANE]`: beside another pane, into a tab beside its focused pane (`split --tab`'s
# word), or a tab of its own, right of the one it leaves and in its group unless a place is named.
# A tab's only pane is the tab: it goes as it is, and keeps its id.
bt_move_pane() {
  bt_mpane=
  bt_mbeside=
  bt_mintab=
  bt_side=
  bt_mnewtab=
  bt_mgroup=
  bt_mwindow=
  bt_mnew=
  bt_mlabel=
  bt_json=
  while [ $# -gt 0 ]; do
    if bt_move_place "$@"; then
      shift "$bt_mshift"
    else
      case $1 in
        --left | --right | --above | --below) bt_take_side "$1" ;;
        --beside)
          [ $# -ge 2 ] || bt_die 64 '--beside takes the pane to go beside'
          [ -z "$bt_mbeside" ] || bt_die 64 'name one pane to go beside'
          shift
          bt_mbeside=$1
          ;;
        --tab | --tab=*)
          [ -z "$bt_mintab" ] || bt_die 64 'name one tab'
          case $1 in
            --tab=*) bt_mintab=${1#--tab=} ;;
            *)
              [ $# -ge 2 ] || bt_die 64 '--tab takes a tab'
              shift
              bt_mintab=$1
              ;;
          esac
          ;;
        --new-tab=*)
          [ -z "$bt_mnewtab" ] || bt_die 64 'name one new tab'
          bt_mnewtab=yes
          bt_move_tab_name "${1#--new-tab=}"
          ;;
        --new-tab)
          [ -z "$bt_mnewtab" ] || bt_die 64 'name one new tab'
          bt_mnewtab=yes
          # The word after it is the new tab's name; one that starts with a dash is another option
          # (`--new-tab=-x` names it).
          if [ $# -ge 2 ]; then
            case $2 in
              -*) ;;
              *)
                shift
                bt_move_tab_name "$1"
                ;;
            esac
          fi
          ;;
        --label | --label=*) bt_die 64 "move takes no --label: a new tab's name goes after --new-tab (move pane p9 --new-tab web); rename names what is there" ;;
        -*) bt_die 64 "move takes no option '$(printf '%s' "$1" | bt_clean)'" ;;
        *)
          [ -z "$bt_mpane" ] || bt_die 64 "move names one pane; a new tab's name goes after --new-tab (move pane p9 --new-tab web)"
          bt_mpane=$1
          ;;
      esac
    fi
    shift
  done
  if [ -z "$bt_mnewtab" ] && [ -n "$bt_mgroup$bt_mwindow$bt_mnew" ]; then
    bt_die 64 '--group, --window and --new-group go with --new-tab (move pane p9 --new-tab --group g1)'
  fi
  case ${bt_mbeside:+x}${bt_mintab:+x}${bt_mnewtab:+x} in
    '') bt_die 64 'move needs a place: --beside PANE and a side, --tab TAB or --new-tab' ;;
    x) ;;
    *) bt_die 64 'a pane goes beside another (--beside), into a tab (--tab) or into a new tab (--new-tab): one of them' ;;
  esac
  if [ -n "$bt_mpane" ]; then
    bt_check_id move pane "$bt_mpane"
  else
    # The caller's own, named by whatever name it has.
    bt_need_here 'name the pane to move (move pane p4 --new-tab)'
    bt_mpane=$bt_me
  fi
  bt_msg="bateri 2${nl}move${nl}terminal $bt_mpane${nl}"
  if [ -n "$bt_mnewtab" ]; then
    [ -z "$bt_side" ] || bt_die 64 'a new tab has no side'
    bt_msg="${bt_msg}side tab${nl}"
    bt_move_place_lines
  elif [ -n "$bt_mintab" ]; then
    bt_check_id move tab "$bt_mintab"
    bt_msg="${bt_msg}tab $bt_mintab${nl}"
    [ -z "$bt_side" ] || bt_msg="${bt_msg}side $bt_side${nl}"
  else
    [ -n "$bt_side" ] || bt_die 64 'move needs a side: --left, --right, --above or --below'
    bt_check_id move pane "$bt_mbeside"
    [ "$bt_mpane" != "$bt_mbeside" ] || bt_die 64 'a pane cannot go beside itself'
    bt_msg="${bt_msg}beside $bt_mbeside${nl}side $bt_side${nl}"
  fi
  bt_moved "$bt_msg"
  if [ -n "$bt_json" ]; then
    printf '{"pane":"%s","tab":%s,"group":%s,"window":%s}\n' "$bt_mpane" "$(bt_json_id "$bt_tab")" "$(bt_json_id "$bt_group")" "$(bt_json_id "$bt_window")"
  elif [ -n "$bt_mnewtab" ]; then
    printf '%s\n' "$bt_tab"
  fi
  exit 0
}

bt_resize_verb() {
  bt_rpane=
  bt_side=
  bt_steps=1
  while [ $# -gt 0 ]; do
    case $1 in
      --left | --right | --above | --below) bt_take_side "$1" ;;
      --by | --by=*)
        case $1 in
          --by=*) bt_steps=${1#--by=} ;;
          *)
            [ $# -ge 2 ] || bt_die 64 '--by takes a number of steps'
            shift
            bt_steps=$1
            ;;
        esac
        case $bt_steps in
          [1-9] | [1-4][0-9] | 50) ;;
          *) bt_die 64 '--by is a number of steps from 1 to 50' ;;
        esac
        ;;
      -*) bt_die 64 "resize takes no option '$(printf '%s' "$1" | bt_clean)'" ;;
      *)
        [ -z "$bt_rpane" ] || bt_die 64 'resize names one pane'
        bt_rpane=$1
        ;;
    esac
    shift
  done
  [ -n "$bt_side" ] || bt_die 64 'resize needs a side: --left, --right, --above or --below'
  bt_msg="bateri 2${nl}resize${nl}"
  if [ -n "$bt_rpane" ]; then
    bt_check_id resize pane "$bt_rpane"
    bt_msg="${bt_msg}terminal $bt_rpane${nl}"
  else
    bt_need_here 'name the pane to resize (resize p4 --right)'
  fi
  bt_do "${bt_msg}side $bt_side${nl}steps $bt_steps${nl}"
}

# ─── what is kablo's own ─────────────────────────────────────────────────

# The word of a command that names a terminal as an ID (never a label), which
# kablo would take for the session of any name.
bt_first_target() {
  bt_skip=
  for bt_a in "$@"; do
    if [ -n "$bt_skip" ]; then
      bt_skip=
      continue
    fi
    case $bt_a in
      --history | --for) bt_skip=1 ;;
      -*) ;;
      *)
        bt_need_terminal "$bt_a"
        return 0
        ;;
    esac
  done
  return 1
}

# `bt_on_machine ARGS...`: the command `bt_cverb` for a pane of the machine `bt_cvia`, its first
# argument the pane's plain id. This Mac's own panes (`@local`) are this machine's when this is the
# Mac; any other machine is reached over ssh from the Mac, and through the Mac from a server
# (`bt_carry`).
bt_on_machine() {
  if [ "$bt_cvia" = local ] && bt_on_mac; then
    exec "$bt_kablo" "$bt_cverb" "$@"
  fi
  bt_carry "$bt_cvia" "$bt_cverb" "$@"
}

# `bt_carry_first VERB ARGS...`: when the first argument is a pane of another machine
# (`p9@prod`), the command is run where the pane is and does not return; else it returns.
bt_carry_first() {
  bt_cverb=$1
  shift
  bt_address "$1" || return 0
  [ -n "$bt_a_machine" ] || return 0
  bt_cvia=$bt_a_machine
  bt_cid=$bt_a_id
  shift
  bt_on_machine "$bt_cid" "$@"
}

# `bt_carry_target VERB ARGS...`: the same for `capture` and `wait`, whose pane is the first word
# that is no option (nor the value of one).
bt_carry_target() {
  bt_cverb=$1
  shift
  bt_cn=$#
  bt_cskip=
  bt_cvia=
  while [ "$bt_cn" -gt 0 ]; do
    bt_ca=$1
    shift
    bt_cn=$((bt_cn - 1))
    if [ -n "$bt_cskip" ]; then
      bt_cskip=
    else
      case $bt_ca in
        --history | --for) bt_cskip=1 ;;
        -*) ;;
        *)
          if [ -z "$bt_cvia" ] && bt_address "$bt_ca" && [ -n "$bt_a_machine" ]; then
            bt_cvia=$bt_a_machine
            bt_ca=$bt_a_id
          fi
          ;;
      esac
    fi
    set -- "$@" "$bt_ca"
  done
  [ -n "$bt_cvia" ] || return 0
  bt_on_machine "$@"
}

# Whether $1 is the name of a key (`send-key` takes a session before the keys).
bt_is_key() {
  case $(printf '%s' "$1" | tr 'A-Z' 'a-z') in
    enter | tab | escape | backspace | space | up | down | left | right | home | end | pageup | pagedown | insert | delete | f[1-9] | f1[0-2] | *+*) return 0 ;;
  esac
  return 1
}

# `bateri --hex WORD...`: the words arrive as `x` and the hex of their bytes (what another machine's
# `bt_remote` and the Mac's relay write, so that no shell reads the caller's bytes); they are turned
# back into the words and the command is read as usual.
if [ "${1-}" = --hex ]; then
  shift
  bt_rn=$#
  while [ "$bt_rn" -gt 0 ]; do
    bt_hexw=$1
    shift
    bt_rn=$((bt_rn - 1))
    case $bt_hexw in
      x*) bt_hexw=${bt_hexw#x} ;;
      *) bt_die 64 '--hex takes words written as x and their bytes in hex' ;;
    esac
    case $bt_hexw in
      *[!0-9A-Fa-f]*) bt_die 64 '--hex takes words written as x and their bytes in hex' ;;
    esac
    [ $((${#bt_hexw} % 2)) -eq 0 ] || bt_die 64 '--hex takes words written as x and their bytes in hex'
    bt_fmt=
    while [ -n "$bt_hexw" ]; do
      bt_pair=${bt_hexw%"${bt_hexw#??}"}
      bt_hexw=${bt_hexw#??}
      bt_byte=$((0x$bt_pair))
      [ "$bt_byte" -ne 0 ] || bt_die 64 'a word has a NUL in it'
      bt_fmt="$bt_fmt\\$((bt_byte / 64))$((bt_byte / 8 % 8))$((bt_byte % 8))"
    done
    bt_w=$(
      printf "$bt_fmt"
      printf x
    )
    set -- "$@" "${bt_w%x}"
  done
fi

[ $# -gt 0 ] || {
  bt_usage >&2
  exit 64
}
bt_cmd=$1
shift
# `--help` anywhere a command's own words are options; what comes after `--`, and the text of the
# verbs that take any text, is not ours to read.
case $bt_cmd in
  send | send-key | notify | rename) ;;
  *)
    for bt_a in "$@"; do
      case $bt_a in
        --) break ;;
        -h | --help)
          bt_usage
          exit 0
          ;;
      esac
    done
    ;;
esac
case $bt_cmd in
  split | tab | window) bt_open "$bt_cmd" "$@" ;;
  close) bt_close "$@" ;;
  focus) bt_focus_verb "$@" ;;
  zoom) bt_zoom_verb "$@" ;;
  swap) bt_swap_verb "$@" ;;
  rename) bt_rename_verb "$@" ;;
  move) bt_move_verb "$@" ;;
  resize) bt_resize_verb "$@" ;;
  ls) bt_ls "$@" ;;
  notify) bt_notify "$@" ;;
  send)
    if [ $# -ge 2 ]; then
      bt_carry_first send "$@"
      bt_need_terminal "$1"
    elif [ $# -eq 1 ] && bt_is_kind p "$1"; then
      # Alone it would be the text, typed into this very terminal.
      bt_die 64 "send needs the text: send $1 TEXT (- reads it from standard input)"
    fi
    exec "$bt_kablo" send "$@"
    ;;
  send-key)
    [ $# -ge 1 ] || bt_die 64 'send-key takes keys to press'
    if ! bt_is_key "$1"; then
      bt_carry_first send-key "$@"
      bt_need_terminal "$1"
    fi
    exec "$bt_kablo" send-key "$@"
    ;;
  capture)
    bt_carry_target capture "$@"
    bt_first_target "$@"
    exec "$bt_kablo" capture "$@"
    ;;
  wait)
    bt_carry_target wait "$@"
    bt_first_target "$@" || bt_die 64 'wait takes the pane to wait for (wait p4)'
    exec "$bt_kablo" wait "$@"
    ;;
  help | -h | --help)
    bt_usage
    exit 0
    ;;
  *)
    bt_say "no command '$(printf '%s' "$bt_cmd" | bt_clean)'"
    bt_usage >&2
    exit 64
    ;;
esac
