#!/bin/sh
# bateri on a machine — what an agent (Claude Code, Codex) asks of the bateri that shows this
# machine's panes. The command is kablo's own (`kablo bateri VERB ...`, the `bateri` subcommand);
# this file only starts it. It is written to `~/.local/share/bateri/shell/bin/bateri` by the
# application on a server and on this Mac, and the integration of zsh, bash and fish puts its
# directory on `PATH`. `__BATERI_KABLO__` is where kablo is on this machine, relative to home,
# which the writer fills in; left as it is (or not there) the command looks for `kablo` on `PATH`.
bt=$HOME/__BATERI_KABLO__; [ -x "$bt" ] || bt=kablo; exec "$bt" bateri "$@"
